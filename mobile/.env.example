# Public mobile client configuration. Never add a secret/service-role key here.
# Copy to .env.local and explicitly choose the intended Supabase environment.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Native Android build-time value. Do not use an unrestricted key.
GOOGLE_MAPS_API_KEY_ANDROID=
