# GameYer canonical public URL
NEXT_PUBLIC_SITE_URL=https://gameyer.az

# Google Search Console verification token (optional for URL-prefix verification;
# Domain Property verification is done with DNS TXT at the registrar/DNS provider.)
# GOOGLE_SITE_VERIFICATION=YOUR_GOOGLE_VERIFICATION_TOKEN

# Supabase public browser/server configuration
# Values Vercel Project Settings > Environment Variables bölməsində saxlanmalıdır.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Meta Pixel browser tracking (optional; digits-only Dataset/Pixel ID)
NEXT_PUBLIC_META_PIXEL_ID=

# Google Analytics 4 browser tracking (optional; G-XXXXXXXXXX Measurement ID)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Founder Command Center server-only provider configuration.
# Never prefix private provider credentials with NEXT_PUBLIC_.
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_API_HOST=https://us.posthog.com

# Meta Ads Insights read-only server adapter.
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=

# Google provider server adapters.
GA4_PROPERTY_ID=
GOOGLE_ANALYTICS_CLIENT_EMAIL=
GOOGLE_ANALYTICS_PRIVATE_KEY=
GSC_SITE_URL=https://gameyer.az/
GOOGLE_SEARCH_CONSOLE_CLIENT_EMAIL=
GOOGLE_SEARCH_CONSOLE_PRIVATE_KEY=
