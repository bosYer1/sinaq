# GameYer public URL
# gameyer.az alınana qədər Vercel production alias:
NEXT_PUBLIC_SITE_URL=https://gameyerr-gameyer.vercel.app
# gameyer.az alındıqdan və Vercel-ə bağlandıqdan sonra yuxarıdakı dəyəri belə dəyiş:
# NEXT_PUBLIC_SITE_URL=https://gameyer.az

# Google Search Console verification token (verification zamanı əlavə olunur)
# GOOGLE_SITE_VERIFICATION=YOUR_GOOGLE_VERIFICATION_TOKEN

# Supabase public browser/server configuration
# Values Vercel Project Settings > Environment Variables bölməsində saxlanmalıdır.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
